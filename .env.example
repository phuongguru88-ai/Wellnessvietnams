# Tuỳ chọn: webhook nhận lead (Google Apps Script / Zapier / Make / n8n...).
# Nếu để trống, lead chỉ được ghi vào data/leads.json trên máy chủ.
LEAD_WEBHOOK_URL=

# Domain dùng cho canonical URL + sitemap
NEXT_PUBLIC_SITE_URL=https://wellnessvietnams.com

# Trang quản trị đối tác (/quan-tri) — bắt buộc phải đặt trước khi deploy.
# Đây là tài khoản QUẢN TRỊ VIÊN GỐC, toàn quyền trên mọi nội dung — dùng để
# đăng nhập lần đầu rồi tạo tài khoản riêng cho từng đối tác trong
# /quan-tri/doi-tac (mỗi đối tác có username/mật khẩu riêng, chỉ thấy và sửa
# được nơi lưu trú đã gán cho họ). Đặt mật khẩu đủ mạnh — người biết mật
# khẩu này xem được số điện thoại khách để lại trên toàn hệ thống.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=doi-mat-khau-nay

# Khoá ký phiên đăng nhập quản trị. Có thể để trống khi chạy thử local —
# hệ thống sẽ tự dùng ADMIN_PASSWORD làm khoá ký. Trên production nên đặt
# một chuỗi ngẫu nhiên riêng (ví dụ: openssl rand -hex 32) để đổi
# ADMIN_PASSWORD không tự làm mất hiệu lực các phiên đăng nhập đang có.
ADMIN_SESSION_SECRET=

# Tuỳ chọn: API key Anthropic (Claude) dùng cho các tính năng AI (phân tích
# khách hàng...). Có thể để trống và nhập trực tiếp trong /quan-tri/cai-dat-ai
# thay vì sửa file này — key nhập trong trang cài đặt được ưu tiên hơn.
ANTHROPIC_API_KEY=
